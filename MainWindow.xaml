<Window x:Class="MahjongSolitaire.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MahjongSolitaire"
        mc:Ignorable="d"
        Title="Mahjong Solitaire"
        Loaded="Window_Loaded"
        ContentRendered="Window_ContentRendered"
        Height="650" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="New Game" FontSize="12" Width="80" Margin="15,0,15,0" Click="NewGameButton_Click"/>
            <Button Content="Shuffle" FontSize="12" Width="80" Margin="15,0,15,0" Click="ShuffleButton_Click"/>
            <Button x:Name="SoundButton" BorderThickness="0" Click="Sound_Click" Background="White" Margin="15,0,15,0">
                <Image x:Name="SoundImage" Source="/images/soundOn.png" Width="30" Height="30"/>
            </Button>
            <TextBlock x:Name="MatchesCount" Text="Matches: 0" FontSize="18" Margin="15,0,15,0" Foreground="Red"/>

        </StackPanel>
        <Canvas x:Name="Table"
                Grid.Row="1"
                Background="ForestGreen"
                PreviewMouseDown="Table_PreviewMouseDown"
                SizeChanged="Table_SizeChanged"/>

    </Grid>
</Window>
